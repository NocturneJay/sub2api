# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# CSS：订阅卡皮肤 (frontend/src/styles/purchase-plan-theme.css) 与运维侧的权威
# 副本需要逐字节比对，工作区一旦被 core.autocrlf 转成 CRLF 就会对不上。
*.css text eol=lf
